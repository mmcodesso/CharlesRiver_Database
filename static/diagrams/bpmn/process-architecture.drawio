        <object id="scope" label="Shared master data, purchasing support, production output, labor and ledger records connect these cycles. Their business dependencies are explained in prose and Mermaid.&#10;An end here means scoped activity is recorded, not that every order, invoice or liability is settled. No global parallel join forces all cycles to finish before financial reporting." bpmnType="heading">
          <mxCell style="html=0;fontFamily=Arial;fontSize=14;fontColor=#152b35;strokeColor=#196252;strokeWidth=1.5;fillColor=#FFFFFF;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=13;align=left;" vertex="1" parent="1">
            <mxGeometry x="40" y="1147" width="1800" height="48" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
