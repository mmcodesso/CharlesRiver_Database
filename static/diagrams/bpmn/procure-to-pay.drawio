<object id="scope" label="Evidence: requisition/PO authorization and receipt/invoice links are recorded; this model does not assert a system-enforced three-way-match block.&#xa;Proposed teaching control: independently compare ordered, received, and invoiced quantities before authorizing payment. Accrued services have a separate no-receipt model." bpmnType="heading" ><mxCell style="html=0;fontFamily=Arial;fontSize=14;fontColor=#152b35;strokeColor=#196252;strokeWidth=1.5;fillColor=#FFFFFF;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1057" width="1800" height="48" as="geometry"/></mxCell></object></root></mxGraphModel></diagram></mxfile>
