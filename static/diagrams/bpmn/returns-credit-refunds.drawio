<object id="scope" label="The refund decision describes the recorded resolution in the selected scope, not an automatic refund policy. Open credit is a meaningful reporting-date outcome.&#xa;Proposed control: independently verify returned quantity, original invoice, credit approval, commission clawback, and any refund authorization before concluding the correction is supported." bpmnType="heading" ><mxCell style="html=0;fontFamily=Arial;fontSize=14;fontColor=#152b35;strokeColor=#196252;strokeWidth=1.5;fillColor=#FFFFFF;whiteSpace=wrap;text;strokeColor=none;fillColor=none;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="947" width="1800" height="48" as="geometry"/></mxCell></object></root></mxGraphModel></diagram></mxfile>
