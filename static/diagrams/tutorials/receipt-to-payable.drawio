<mxfile host="app.diagrams.net"><diagram id="receipt-to-payable" name="Follow a Purchase"><mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="How do receipt, billing, and payment change the liability?" style="text;html=0;whiteSpace=wrap;fontSize=23;fontStyle=1;fontColor=#163d48;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="920" height="60" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;1. Receipt line 25479&lt;/b&gt;&lt;br&gt;&lt;br&gt;27 September 2026&lt;br&gt;Standard cost: 8.83&lt;br&gt;Inventory / GRNI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f2ef;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="25" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;2. Supplier invoice 36461&lt;/b&gt;&lt;br&gt;&lt;br&gt;29 November 2026&lt;br&gt;Goods 8.83 + tax 0.13&lt;br&gt;Accounts payable: 8.96" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f4ed;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;3. Payment 39645&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 January 2027&lt;br&gt;Paid: 8.96&lt;br&gt;Still payable at 2026 year end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f7;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="665" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#48766e;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#48766e;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="footer" value="Charles River · guided tutorial" style="text;html=0;fontColor=#526869;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="450" width="920" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
