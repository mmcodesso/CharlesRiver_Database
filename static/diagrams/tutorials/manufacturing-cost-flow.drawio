<mxfile host="app.diagrams.net"><diagram id="manufacturing-cost-flow" name="Follow Manufacturing Costs"><mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="When are the goods complete and the work order closed?" style="text;html=0;whiteSpace=wrap;fontSize=23;fontStyle=1;fontColor=#163d48;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="920" height="60" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;1. Work order 1: issue&lt;/b&gt;&lt;br&gt;&lt;br&gt;17 January 2024&lt;br&gt;Material issue cost: 754.29&lt;br&gt;Materials move into WIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f2ef;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="25" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;2. Two completions&lt;/b&gt;&lt;br&gt;&lt;br&gt;25–26 January 2024&lt;br&gt;Standard total cost: 1,019.85&lt;br&gt;Finished goods available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f4ed;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;3. Work-order close 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 February 2024&lt;br&gt;Total variance: 743.16&lt;br&gt;Close is a later event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f7;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="665" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#48766e;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n0" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#48766e;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="footer" value="Charles River · guided tutorial · released example v2027.1" style="text;html=0;fontColor=#526869;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="450" width="920" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
