<mxfile host="app.diagrams.net"><diagram id="meet-the-records" name="Meet the Records"><mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Which parts of a customer row identify and describe it?" style="text;html=0;whiteSpace=wrap;fontSize=23;fontStyle=1;fontColor=#163d48;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="15" width="920" height="60" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;1. A key identifies the record&lt;/b&gt;&lt;br&gt;&lt;br&gt;CustomerID: 130&lt;br&gt;Used to link customer records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f2ef;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="25" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;2. A name describes the customer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Jones, Richardson and Beard&lt;br&gt;CustomerName" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f4ed;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;3. A segment classifies it&lt;/b&gt;&lt;br&gt;&lt;br&gt;Design Trade&lt;br&gt;CustomerSegment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf1f7;strokeColor=#48766e;fontColor=#183c48;fontSize=18;spacing=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="665" y="110" width="285" height="230" as="geometry"/></mxCell><mxCell id="footer" value="Charles River · guided tutorial · released example v2027.1" style="text;html=0;fontColor=#526869;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="450" width="920" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
