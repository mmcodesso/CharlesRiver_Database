<mxfile host="Electron" version="29.6.6" type="device">
  <diagram id="case03-transitions" name="How does the obligation change its accounting form?">
    <mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1160" pageHeight="1000" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="title" label="How does the obligation change its accounting form?">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;" vertex="1" parent="1">
            <mxGeometry x="25" y="15" width="1110" height="70" as="geometry" />
          </mxCell>
        </object>
        <object id="subtitle" label="Distinguish pre-invoice obligations, accounts payable, payment, and any independent residual-accrual adjustment.">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=0;" vertex="1" parent="1">
            <mxGeometry x="25" y="87" width="1110" height="55" as="geometry" />
          </mxCell>
        </object>
        <object id="n0" label="Before a supplier bill&#10;&#10;Receipt or expense estimate creates a liability before a supplier bill.">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#f6f4ee;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
            <mxGeometry x="25" y="170" width="330" height="235" as="geometry" />
          </mxCell>
        </object>
        <object id="n1" label="Accounts payable&#10;&#10;The supplier invoice transfers the supported amount into accounts payable.">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#f6f4ee;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
            <mxGeometry x="410" y="170" width="330" height="235" as="geometry" />
          </mxCell>
        </object>
        <object id="n2" label="Cash payment&#10;&#10;Payment clears the invoiced AP amount.">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#f6f4ee;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
            <mxGeometry x="795" y="170" width="330" height="235" as="geometry" />
          </mxCell>
        </object>
        <object id="adjustment" label="Residual-estimate adjustment&#10;&#10;For an accrued service, compare the original estimate with the supported invoice amount. A linked adjustment clears any unused estimate separately.">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;rounded=1;arcSize=6;fillColor=#f6f4ee;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
            <mxGeometry x="25" y="535" width="715" height="215" as="geometry" />
          </mxCell>
        </object>
        <object id="recognition" label="invoice" relationKind="context">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;rounded=0;fillColor=none;fontSize=17;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n0" target="n1">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="settlement" label="payment" relationKind="context">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;rounded=0;fillColor=none;fontSize=17;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object id="estimate-adjustment" label="estimate difference" relationKind="context">
          <mxCell style="html=0;fontFamily=Arial;fontSize=20;fontColor=#17333e;strokeColor=#196252;strokeWidth=1.5;whiteSpace=wrap;edgeStyle=orthogonalEdgeStyle;rounded=0;fillColor=none;fontSize=17;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n0" target="adjustment">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="5" y="285" />
                <mxPoint x="5" y="642" />
